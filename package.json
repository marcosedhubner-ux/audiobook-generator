    "ffmpeg-static": "^5.3.0",
    "fluent-ffmpeg": "^2.1.3",
    "msedge-tts": "^2.0.7",
    "multer": "^2.2.0",
    "open": "^11.0.1",
    "ora": "^8.1.1",
